  m_Script: {fileID: 11500000, guid: 201251c41f0f7dd4b9fb2f37507c8f40, type: 3}
  m_Name: Fala A
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - "Intruso: Boa noite, sabe me dizer como eu posso ir para o pr\xF3ximo andar ?"
  - "Convidada: Sei sim, mas s\xF3 vou dizer se me fizer um favor "
  - "Convidada: Perdi minha alian\xE7a enquanto andava por aqui. Pode parecer bobo,
    mas\u2026eu preciso dela.\r\n"
  - 'Convidada: Se a encontrar, eu te ajudo'
