  m_Script: {fileID: 11500000, guid: 201251c41f0f7dd4b9fb2f37507c8f40, type: 3}
  m_Name: Fala A 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - "Intruso: Boa noite, o elevador est\xE1 fechado ?\r\n"
  - "Funcion\xE1rio: S\xF3 um gerente tem acesso ao elevador, voc\xEA deveria saber
    disso."
  - "Intruso: Entendo\u2026\r\n"
  - "Funcion\xE1rio: Por que quer ir l\xE1 para cima ? N\xE3o tem nada de bom l\xE1,
    eu garanto.\r\n"
  - "Intruso: Acho que minha esposa pode estar l\xE1.\r\n"
  - "Funcion\xE1rio: Entendo, tamb\xE9m sou casado. Tive uma discuss\xE3o com a minha
    mulher e vim esfriar a cabe\xE7a \r\n\r\n\r\n"
  - "Funcion\xE1rio: \xC9 o seguinte\u2026pegue essas ta\xE7as. Entregue-as para
    as pessoas certas e eu te ajudo\r\n"
