  m_Script: {fileID: 11500000, guid: 201251c41f0f7dd4b9fb2f37507c8f40, type: 3}
  m_Name: Fala C 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - "Intruso: Todas as ta\xE7as foram entregues\r\n"
  - "Funcion\xE1rio: Ok\u2026\r\n"
  - "Intruso: Est\xE1 tudo bem ?\r\n"
  - "Funcion\xE1rio: Eu sou um idiota.\r\n"
  - "Funcion\xE1rio: Pegue. Com essa m\xE1scara voc\xEA poder\xE1 usar o elevador,
    e n\xE3o diga a ningu\xE9m que eu lhe dei isso. \r\n"
  - "Funcion\xE1rio: Vou consertar as coisas com a minha esposa\u2026 Espero que
    voc\xEA encontre a sua. "
